{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"cra.result/1","title":"Analysis result","type":"object",
"required":["schema_version","created_at","scan_status","product","source","collector","engine","policy","scanners","vulnerability_data","artifacts","coverage","summary","findings","evaluation","tool_diagnostics","not_matchable"],
"properties":{"schema_version":{"const":"cra.result/1"},"scan_status":{"enum":["complete","incomplete"]},
"evaluation":{"type":"object","required":["build","release"],"properties":{"build":{"$ref":"#/$defs/evaluation"},"release":{"$ref":"#/$defs/evaluation"}}},
"findings":{"type":"array","items":{"$ref":"#/$defs/finding"}},
"tool_diagnostics":{"type":"array","items":{"type":"object","required":["code","severity","origin","message"]}}},
"$defs":{"evaluation":{"type":"object","required":["mode","outcome","incomplete_reasons","policy_violations"],"properties":{"outcome":{"enum":["passed","policy_blocked","incomplete"]}}},
"finding":{"type":"object","required":["id","origin","component","vulnerability","severity","matching","presence","artifacts","configurations","dependency_paths","remediation","kev","exploitability","triage","uncertainty","missing_evidence"],
"properties":{"origin":{"const":"product"},
"component":{"type":"object","required":["name","version","purl","ecosystem","evidence","joined_to_inventory"]},
"vulnerability":{"type":"object","required":["id","aliases","source","description"],"properties":{"source":{"type":"object","required":["namespace","url"]}}},
"matching":{"type":"object","required":["scanner","match_types","confidence","rationale"],"properties":{"confidence":{"enum":["high","medium","low","claim"]}}},
"exploitability":{"type":"object","required":["established","status","basis"]},
"triage":{"type":"object","required":["status","justification","statement","provenance","rejected_statements","problem"],"properties":{"status":{"enum":["needs_triage","under_investigation","affected","not_affected","fixed"]}}},
"remediation":{"type":"object","required":["fix_state","fixed_in","note"]},"presence":{"type":"object","required":["shipped","shipped_rationale","scope"]}}}}}
